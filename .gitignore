*.slo
*.a
*.la
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.app
*.pdb
*.ilk
*.exp

# ── Python (preset runtime) ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/

# ── Editor / IDE ──────────────────────────────────────────────────────────────
# VS Code (workspace settings can be project-specific; ignore by default)
.vscode/
# JetBrains
.idea/
*.iml
# clangd / LSP index
.cache/
# Vim
*.swp
*.swo
*~
# Emacs
\#*\#
.\#*
# Antigravity (per CLAUDE.md dev environment)
.antigravity/

# ── OS metadata ───────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Logs and runtime artefacts ────────────────────────────────────────────────
*.log
*.tmp
*.bak
# Unix core dumps — anchored to repo root so they don't catch src/core/
/core
/core.*

# ── Local environment / secrets ───────────────────────────────────────────────
.env
.env.local
*.local
